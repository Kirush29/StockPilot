# ==============================================================================
# StockPilot Monorepo .gitignore
# Stack: .NET 8 Web API + React 19 / Vite + Flutter / Dart + Python Agentic AI
# ==============================================================================

# ------------------------------------------------------------------------------
# .NET / C#
# ------------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
**/[Bb]in/
**/[Oo]bj/
*.user
*.userosscache
*.suo
*.userprefs
*.pidb
*.booproj
*.svclog
*.sln.docstates
.vs/
**/.vs/

# .NET Test & Code Coverage
[Tt]est[Rr]esults/
**/[Tt]est[Rr]esults/
[Cc]overage/
*.opencover.xml

# ------------------------------------------------------------------------------
# Node.js / React / Vite
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
*.local
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# Flutter / Dart / Mobile
# ------------------------------------------------------------------------------
.dart_tool/
**/.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
**/build/

# Android
android/.gradle/
**/android/.gradle/
android/captures/
android/local.properties
android/**/GeneratedPluginRegistrant.java

# iOS / macOS / Windows Desktop Flutter artifacts
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/app.flx
ios/Flutter/app.zip
ios/Flutter/flutter_assets/
windows/flutter/ephemeral/
linux/flutter/ephemeral/
macos/Flutter/ephemeral/

# ------------------------------------------------------------------------------
# Python / Agentic AI
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/
.coverage
htmlcov/

# ------------------------------------------------------------------------------
# Secrets & Environment Configurations (Never commit real credentials)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
secrets.json
appsettings.Development.json
**/appsettings.Development.json
*.pfx
*.pem
*.key

# ------------------------------------------------------------------------------
# Operating System & IDE Artifacts
# ------------------------------------------------------------------------------
.idea/
**/.idea/
.vscode/
**/.vscode/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# Logs & Diagnostic Files
# ------------------------------------------------------------------------------
*.log
logs/
**/logs/
