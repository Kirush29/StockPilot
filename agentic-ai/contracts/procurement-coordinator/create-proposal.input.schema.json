{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateProposalToolInput",
  "description": "There is deliberately no status, approval or createdByAgent field: the tool always submits the proposal as PendingApproval and flags it as agent-created.",
  "type": "object",
  "additionalProperties": false,
  "required": ["branchId", "supplierId", "quotationId", "productId", "quantity", "unitPrice", "justification"],
  "properties": {
    "branchId": { "$ref": "#/$defs/uuid" },
    "supplierId": { "$ref": "#/$defs/uuid" },
    "quotationId": { "$ref": "#/$defs/uuid" },
    "productId": { "$ref": "#/$defs/uuid" },
    "quantity": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "unitPrice": { "type": "number", "exclusiveMinimum": 0, "maximum": 9999999999.99 },
    "justification": { "type": "string", "minLength": 1, "maxLength": 2000 }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "not": { "const": "00000000-0000-0000-0000-000000000000" }
    }
  }
}
