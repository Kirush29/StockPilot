{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ValidateBusinessRulesToolOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["passed", "results"],
  "properties": {
    "passed": { "type": "boolean" },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "passed", "details"],
        "properties": {
          "rule": { "type": "string", "maxLength": 100 },
          "passed": { "type": "boolean" },
          "details": { "type": "string", "maxLength": 500 }
        }
      }
    }
  }
}
