{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CheckBudgetToolInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["branchId", "periodStart", "periodEnd", "proposedAmount"],
  "properties": {
    "branchId": { "$ref": "#/$defs/uuid" },
    "periodStart": { "$ref": "#/$defs/date" },
    "periodEnd": { "$ref": "#/$defs/date" },
    "proposedAmount": { "type": "number", "exclusiveMinimum": 0, "maximum": 9999999999.99 }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "not": { "const": "00000000-0000-0000-0000-000000000000" }
    },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  }
}
