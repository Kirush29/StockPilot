{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ValidateBusinessRulesToolInput",
  "description": "quantity is only type- and range-checked here so that a non-positive quantity is reported as a named QuantityPositive rule failure rather than a schema error.",
  "type": "object",
  "additionalProperties": false,
  "required": ["branchId", "supplierId", "quotationId", "productId", "quantity", "unitPrice"],
  "properties": {
    "branchId": { "$ref": "#/$defs/uuid" },
    "supplierId": { "$ref": "#/$defs/uuid" },
    "quotationId": { "$ref": "#/$defs/uuid" },
    "productId": { "$ref": "#/$defs/uuid" },
    "quantity": { "type": "integer", "minimum": -1000000, "maximum": 1000000 },
    "unitPrice": { "type": "number", "minimum": 0, "maximum": 9999999999.99 }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "not": { "const": "00000000-0000-0000-0000-000000000000" }
    }
  }
}
