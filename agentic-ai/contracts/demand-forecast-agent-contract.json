{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DemandForecastAgentContract",
  "description": "Formal contract specification for the StockPilot Demand Forecast Agent (SE3090 Agentic AI workflow).",
  "type": "object",
  "required": [
    "workflowId",
    "objective",
    "initiatedBy",
    "currentStep",
    "plan",
    "toolExecutions",
    "validationResults",
    "errors",
    "retryCount",
    "approvalStatus",
    "finalOutcome"
  ],
  "properties": {
    "workflowId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this workflow trace."
    },
    "objective": {
      "type": "string",
      "description": "High-level goal for the demand forecast run (e.g. Generate 30-day forecast for SKU-PARACETAMOL-500 at Colombo Central)."
    },
    "initiatedBy": {
      "type": "string",
      "description": "User ID, operator role, or parent agent ID triggering the execution."
    },
    "currentStep": {
      "type": "string",
      "enum": [
        "PlanInitialization",
        "FetchSalesHistory",
        "ComputeStatisticalBaseline",
        "EvaluateMarketFactors",
        "SynthesizeForecast",
        "Completed",
        "Failed"
      ]
    },
    "plan": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stepIndex": { "type": "integer" },
          "action": { "type": "string" },
          "status": { "type": "string", "enum": ["Pending", "Running", "Completed", "Failed", "Skipped"] }
        },
        "required": ["stepIndex", "action", "status"]
      }
    },
    "toolExecutions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "toolName": { "type": "string" },
          "inputParameters": { "type": "object" },
          "outputPayload": { "type": "object" },
          "executedAtUtc": { "type": "string", "format": "date-time" },
          "durationMs": { "type": "integer" },
          "isSuccess": { "type": "boolean" },
          "errorMessage": { "type": ["string", "null"] }
        },
        "required": ["toolName", "inputParameters", "outputPayload", "executedAtUtc", "durationMs", "isSuccess"]
      }
    },
    "validationResults": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule": { "type": "string" },
          "passed": { "type": "boolean" },
          "details": { "type": "string" }
        },
        "required": ["rule", "passed", "details"]
      }
    },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "retryCount": {
      "type": "integer",
      "minimum": 0
    },
    "approvalStatus": {
      "type": "string",
      "enum": ["Pending", "NotRequired", "Approved", "Rejected"]
    },
    "finalOutcome": {
      "type": ["object", "null"],
      "properties": {
        "forecastId": { "type": "string", "format": "uuid" },
        "productId": { "type": "string", "format": "uuid" },
        "predictedTotalDemand": { "type": "number" },
        "averageDailyDemand": { "type": "number" },
        "reorderPoint": { "type": "number" },
        "safetyStock": { "type": "number" },
        "confidenceScore": { "type": "number" },
        "trend": { "type": "string", "enum": ["Stable", "Increasing", "Decreasing", "Seasonal"] },
        "reasoning": { "type": "string" }
      }
    }
  }
}
