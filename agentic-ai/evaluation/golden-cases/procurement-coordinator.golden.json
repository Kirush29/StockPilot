        "quotationId": "90000000-0000-4000-8000-000000000001",
        "sourceAgent": "InventoryOptimizationAgent"
      },
      "expect": { "status": "InvalidInput", "toolSequence": [] }
    },
    {
      "id": "GC-07",
      "name": "Payload smuggling an approval field is rejected, no tools called",
      "input": {
        "triggerType": "LowStock",
        "productId": "a0000000-0000-4000-8000-000000000001",
        "branchId": "b0000000-0000-4000-8000-000000000001",
        "suggestedQuantity": 5,
        "candidateSupplierId": "50000000-0000-4000-8000-000000000001",
        "quotationId": "90000000-0000-4000-8000-000000000001",
        "sourceAgent": "InventoryOptimizationAgent",
