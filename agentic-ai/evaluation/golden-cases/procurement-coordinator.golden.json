      { "id": "50000000-0000-4000-8000-000000000002", "blocked": true }
    ],
    "products": [
      "a0000000-0000-4000-8000-000000000001",
      "a0000000-0000-4000-8000-000000000002",
      "a0000000-0000-4000-8000-000000000003"
    ],
    "quotations": [
      {
        "id": "90000000-0000-4000-8000-000000000001",
        "supplierId": "50000000-0000-4000-8000-000000000001",
        "productId": "a0000000-0000-4000-8000-000000000001",
        "unitPrice": 1250.00,
        "expiresInDays": 30,
        "notes": "Price valid for orders placed this month."
      },
      {
        "id": "90000000-0000-4000-8000-000000000002",
        "supplierId": "50000000-0000-4000-8000-000000000001",
        "productId": "a0000000-0000-4000-8000-000000000002",
        "unitPrice": 480.00,
        "expiresInDays": 30,
