      {
        "id": "90000000-0000-4000-8000-000000000003",
        "supplierId": "50000000-0000-4000-8000-000000000002",
        "productId": "a0000000-0000-4000-8000-000000000003",
        "unitPrice": 75.00,
        "expiresInDays": 30,
        "notes": null
      }
