{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "UseInMemoryDatabase": "false",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=stockpilotdb;Username=postgres;Password=YOUR_DATABASE_PASSWORD"
  },
  "AgenticAi": {
    "PythonPath": "python",
    "WorkingDirectory": "../../agentic-ai",
    "EntryPoint": "-m agents.supplier_evaluation",
    "TimeoutSeconds": 60,
    "AgentMode": "deterministic"
  },
  "Email": {
    "UseFakeProvider": true,
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUsername": "dummy@example.com",
    "SmtpPassword": "",
    "FromAddress": "noreply@stockpilot.local",
    "FromName": "StockPilot System"
  },
  "Jwt": {
    "Issuer": "StockPilot",
    "Audience": "StockPilotClients",
    "SigningKey": ""
  },
  "DevAuth": {
    "PasswordHash": "AQAAAAIAAYagAAAAENipBOnahM0Al6mYlKirMZRTcQUl6hXlLUB5SvsD/wBVFLJ55mW7cLqtzZZuKU3QlA=="
  },
  "Procurement": {
    "ApprovalLimits": {
      "ProcurementManager": 50000,
      "BusinessOwner": null
    },
    "CoordinatorAgent": {
      "ToolTimeoutSeconds": 10,
      "MaxRetries": 2,
      "RetryBackoffMilliseconds": 250,
      "LlmTimeoutSeconds": 15
    }
  }
}
