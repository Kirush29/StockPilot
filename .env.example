# ==============================================================================
# StockPilot Environment Variables Configuration
# Copy this file to .env (or configure in container / deployment environment)
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# ==============================================================================

# Database Connection (ASP.NET Core standard format)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=stockpilotdb;Username=postgres;Password=YOUR_DATABASE_PASSWORD
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@localhost:5432/stockpilotdb

# JWT Authentication (SigningKey MUST be at least 32 characters long)
Jwt__Issuer=StockPilot
Jwt__Audience=StockPilotClients
Jwt__SigningKey=CHANGE_ME_TO_A_SECURE_KEY_OF_AT_LEAST_32_CHARACTERS_FOR_PRODUCTION
JWT_SIGNING_KEY=CHANGE_ME_TO_A_SECURE_KEY_OF_AT_LEAST_32_CHARACTERS_FOR_PRODUCTION

# AI & LLM Model Providers (Optional; deterministic fallback is default)
OpenAI__ApiKey=
OPENAI_API_KEY=
GEMINI_API_KEY=
AGENT_MODEL_PROVIDER=gemini
AGENT_MODEL_API_KEY=

# Agentic AI Subprocess Configuration
AgenticAi__WorkingDirectory=../../agentic-ai
AgenticAi__PythonPath=python
AgenticAi__AgentMode=deterministic
AgenticAi__TimeoutSeconds=60

# Third-party / Email (Optional)
EMAIL_API_KEY=
EXCHANGE_RATE_API_KEY=
